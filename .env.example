# Sans jeton, Cockpit tourne sur la démo (Maison Orée, une agence fictive), branchée sur un faux Pennylane.
# Pour tes vraies données : dans Pennylane, Paramètres → Connectivité → Développeurs → Générer un jeton d'API
# (offre Essentiel ou plus ; seuls les dirigeants et les comptables voient cet onglet).
# Droits à cocher : factures clients en lecture et écriture, clients et transactions en lecture.
# Le jeton reste sur ton ordinateur, côté serveur : il n'est jamais envoyé au navigateur.
PENNYLANE_API_TOKEN=

# Objectif de chiffre d'affaires HT de l'année (la jauge en bas du menu).
# Laisse vide : Cockpit vise +10 % sur tes 12 derniers mois.
COCKPIT_OBJECTIF_ANNUEL=
